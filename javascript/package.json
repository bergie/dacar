{
  "name": "@reticulum/dacar",
  "version": "1.6.0",
  "description": "JavaScript implementation of Dacar, a Decentralized Access Control system for Reticulum",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./transport": {
      "types": "./types/src/transport/index.d.ts",
      "default": "./src/transport/index.js"
    },
    "./cli/session": "./src/cli/session.js",
    "./cli/store": "./src/cli/store.js",
    "./package.json": "./package.json",
    "./cli/fileStore": "./src/cli/fileStore.js"
  },
  "bin": {
    "dacar": "src/cli/dacar.js"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "types": "tsc --allowJs --declaration --emitDeclarationOnly --outDir types --rootDir . --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck src/index.js src/transport/index.js && node scripts/fix-dts.mjs",
    "prepublishOnly": "npm run types",
    "test": "sh scripts/test.sh",
    "test:node": "node --test --test-force-exit test/*.test.js",
    "test:deno": "deno test --allow-read=test,src --allow-env --no-check test/",
    "test:bun": "bun test test/"
  },
  "keywords": [
    "reticulum",
    "rns",
    "access-control",
    "authorization",
    "crdt",
    "mesh",
    "offline"
  ],
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bergie/dacar.git",
    "directory": "javascript"
  },
  "homepage": "https://github.com/bergie/dacar#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@reticulum/core": "^0.9.3",
    "@reticulum/lxmf": "^0.9.3",
    "@reticulum/node": "^0.9.3",
    "@reticulum/rfed": "^0.9.3",
    "@types/node": "^26.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
